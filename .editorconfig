root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,tsx,json,yaml,yml}]
indent_size = 2

[*.{hcl,tf}]
indent_size = 2

[*.sh]
indent_size = 2

[*.{md,markdown}]
indent_size = unset
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx}]
indent_size = 2

[services/api/ItSupport.Api/Generated/*.g.cs]
insert_final_newline = unset

[Makefile]
indent_style = tab
