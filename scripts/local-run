#!/bin/sh
# Run one deployment workflow on this machine, against staging.
#
#   scripts/local-run <infra|app|ingest|ci|power-platform> [extra options]
#
# Each workflow runs under the event a local run means: infra and
# ingest run as workflow_dispatch (their non-pull-request path), the
# others as pull_request. The workflows carry their own local-run
# guards: Infra reaches its plan and stops, App builds the image
# without pushing it, Ingest reaches the staging push, and the Power
# Platform workflow reaches its pack. Nothing a local run does can
# reach production, and release.yml is not offered here at all.
# Extra options are passed through to the runner.
#
# Honesty about the loop: act pulls images from the registry by
# default — it is not an offline hermetic runner. A locally built
# image is used only when a matching image already sits in the local
# Docker store; otherwise the registry one wins. The loop proves the
# workflow's steps and guards, not the exact bytes CI ships. The one
# hard gap is documented in docs/local-loop.md: staging cannot consume
# a CI-built image from a local run.
set -eu
cd "$(git rev-parse --show-toplevel)"

case "${1:-}" in
    infra | ingest)
        workflow=".github/workflows/$1.yml"
        event=workflow_dispatch
        ;;
    ci | app | power-platform)
        workflow=".github/workflows/$1.yml"
        event=pull_request
        ;;
    *)
        echo "usage: $0 <infra|ingest|ci|app|power-platform>" >&2
        exit 64
        ;;
esac
shift

[ -f .env.local ] || {
    echo ".env.local is missing; see docs/local-loop.md for the setup." >&2
    exit 69
}

set -- \
    "$event" \
    -W "$workflow" \
    --secret-file .env.local

# The staging jobs read their variables from the environment, which the
# local runner supplies through a variables file instead.
if [ -f .vars ]; then
    set -- "$@" --var-file .vars
fi

if [ -f event.json ]; then
    set -- "$@" -e event.json
fi

# The loop's exit status is the runner's. It is captured explicitly and
# repeated as the last output line, so a piped or captured log — which
# loses the exit status to the pipe's last command — still ends with the
# verdict, and a run that failed can never look green from its output.
rc=0
act "$@" \
    -P ubuntu-latest=catthehacker/ubuntu:act-latest \
    --container-daemon-socket /var/run/docker.sock || rc=$?
echo "local-run: act exited with status $rc"
exit "$rc"
