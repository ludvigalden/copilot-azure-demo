#!/bin/sh
# Run one deployment workflow on this machine, against staging.
#
#   scripts/local-run <infra|app|ingest|ci|power-platform> [extra options]
#
# The workflows carry their own local-run guards: Infra reaches its
# plan and stops, App builds without pushing and reaches the staging
# deploy, Ingest reaches the staging push, and the Power Platform
# workflow reaches its pack. Nothing a local run does can reach
# production. Extra options are passed through to the runner.
set -eu
cd "$(git rev-parse --show-toplevel)"

case "${1:-}" in
    infra | app | ingest | ci | power-platform)
        workflow=".github/workflows/$1.yml"
        shift
        ;;
    *)
        echo "usage: $0 <infra|app|ingest|ci|power-platform>" >&2
        exit 64
        ;;
esac

[ -f .env.local ] || {
    echo ".env.local is missing; see docs/local-loop.md for the setup." >&2
    exit 69
}

set -- \
    -W "$workflow" \
    --secret-file .env.local

# The staging jobs read their variables from the environment, which the
# local runner supplies through a variables file instead.
if [ -f .vars ]; then
    set -- "$@" --var-file .vars
fi

if [ -f event.json ]; then
    set -- "$@" -e event.json
fi

# The loop's exit status is the runner's. It is captured explicitly and
# repeated as the last output line, so a piped or captured log — which
# loses the exit status to the pipe's last command — still ends with the
# verdict, and a run that failed can never look green from its output.
rc=0
act "$@" \
    -P ubuntu-latest=catthehacker/ubuntu:act-latest \
    --container-daemon-socket /var/run/docker.sock || rc=$?
echo "local-run: act exited with status $rc"
exit "$rc"
