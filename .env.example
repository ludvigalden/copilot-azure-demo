# Prefix for every Azure resource name; Terraform derives all names from it.
TF_VAR_prefix=demo-prefix
# GitHub repository (owner/name) that CD deploys from.
TF_VAR_github_repository=owner/repo

# Entra ID tenant and application IDs for the API's Entra authentication.
# Leave commented out to run locally on the development stand-ins.
#AzureAd__TenantId=00000000-0000-0000-0000-000000000000
#AzureAd__ClientId=00000000-0000-0000-0000-000000000000
# Client secret used for the on-behalf-of token exchange to Microsoft Graph; needed only when the Azure AD block above is set.
#AzureAd__ClientCredentials__0__SourceType=ClientSecret
#AzureAd__ClientCredentials__0__ClientSecret=placeholder

# ServiceNow instance; set them to create tickets in ServiceNow instead of the built-in store.
#ServiceNow__InstanceUrl=https://dev00000.service-now.com
#ServiceNow__Username=admin
#ServiceNow__Password=placeholder
